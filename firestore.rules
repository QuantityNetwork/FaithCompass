rules_version = '2';

// AbrahamMoses security rules (ADR 0001). Project abrahammoses-a0a26.
//
// There is no admin key: every write, from the browser SDK or from a server route forwarding the user's own ID
// token, is checked here. Deny by default; anonymous visitors and anonymous-auth users never write; roles come only
// from the custom claim `am_role`; the editor is never the proposer; the canonical record changes only in the same
// atomic batch as an approved decision and its audit event; audit events are append-only; tenants are isolated.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function uid() { return request.auth.uid; }
    function role() {
      return signedIn() ? request.auth.token.get('am_role', 'research_contributor') : 'public_reader';
    }
    function isEditor() { return role() in ['research_editor', 'editorial_admin']; }
    // Workspace membership: the custom claim `am_tenants` (tenant id -> 'member' | 'editor', set only by the project
    // owner) or a members document (written only from the console). Clients can set neither.
    function tenantClaim(t) {
      return request.auth.token.get('am_tenants', {}).get(t, '');
    }
    function memberDoc(t) { return /databases/$(database)/documents/tenants/$(t)/members/$(uid()); }
    function isMember(t) {
      return signedIn() && (tenantClaim(t) in ['member', 'editor'] || exists(memberDoc(t)));
    }
    function isTenantEditor(t) {
      return signedIn() && (tenantClaim(t) == 'editor'
        || (exists(memberDoc(t)) && get(memberDoc(t)).data.get('role', 'member') == 'editor'));
    }
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function proposalPath(pid) { return /databases/$(database)/documents/evidence_challenge_proposals/$(pid); }
    function auditPath(aid) { return /databases/$(database)/documents/evidence_audit/$(aid); }
    // True only inside the batch in which this editor approves proposal `pid`, which was undecided before the batch
    // and was not proposed by them.
    function approvingNow(pid) {
      return signedIn() && isEditor()
        && get(proposalPath(pid)).data.status == 'proposed'
        && get(proposalPath(pid)).data.proposedBy != uid()
        && getAfter(proposalPath(pid)).data.status == 'approved'
        && getAfter(proposalPath(pid)).data.decidedBy == uid();
    }

    // Canonical record: public read. It changes only with an approval: the revised analysis, the proposal decision
    // and the audit event in one batch.
    match /evidence_analyses/{id} {
      allow read: if true;
      allow create, update: if approvingNow(request.resource.data.lastProposalId)
        && getAfter(proposalPath(request.resource.data.lastProposalId)).data.analysisId == id
        && existsAfter(auditPath(request.resource.data.lastAuditId));
      allow delete: if false;
    }
    match /evidence_challenges/{id} {
      allow read: if true;
      allow create: if approvingNow(request.resource.data.proposalId)
        && getAfter(proposalPath(request.resource.data.proposalId)).data.claimId == request.resource.data.claimId;
      allow update, delete: if false;
    }

    // Proposals (user research): kept apart from the canonical record. Signed-in users only.
    match /evidence_challenge_proposals/{id} {
      allow read: if signedIn() && (resource.data.proposedBy == uid() || isEditor());
      allow create: if signedIn()
        && request.resource.data.proposedBy == uid()
        && request.resource.data.status == 'proposed'
        && request.resource.data.decidedBy == null;
      // A decision: an editor who is not the proposer, recorded as themselves, with its audit event in the same
      // batch. Nothing but the decision fields may change.
      allow update: if signedIn() && isEditor()
        && resource.data.status == 'proposed'
        && resource.data.proposedBy != uid()
        && request.resource.data.status in ['approved', 'rejected', 'superseded']
        && request.resource.data.decidedBy == uid()
        && unchanged(['json', 'claimId', 'analysisId', 'proposedBy', 'proposerRole', 'idempotencyKey', 'createdAt'])
        && existsAfter(auditPath(request.resource.data.decisionAuditId))
        && getAfter(auditPath(request.resource.data.decisionAuditId)).data.proposalId == id;
      allow delete: if false;
    }

    // Drafts: private to their creator; never published by being created.
    match /evidence_analysis_drafts/{id} {
      allow read: if signedIn() && resource.data.createdBy == uid();
      allow create: if signedIn() && request.resource.data.createdBy == uid();
      allow update, delete: if false;
    }

    // Audit log: append-only, every event attributed to the signed-in user who caused it.
    match /evidence_audit/{id} {
      allow read: if role() in ['editorial_admin', 'system_admin'];
      allow create: if signedIn() && request.resource.data.actorId == uid() && (
        // A decision event, in the batch that decides the proposal
        (request.resource.data.changeType in ['APPROVED', 'REJECTED', 'UPDATED']
          && isEditor()
          && get(proposalPath(request.resource.data.proposalId)).data.status == 'proposed'
          && getAfter(proposalPath(request.resource.data.proposalId)).data.decidedBy == uid())
        // The proposer's own submission event
        || (request.resource.data.changeType == 'PROPOSED'
          && request.resource.data.entityType == 'PROPOSAL'
          && request.resource.data.proposalId == request.resource.data.entityId
          && get(proposalPath(request.resource.data.entityId)).data.proposedBy == uid())
        // The creator's own draft event
        || (request.resource.data.changeType == 'DRAFTED'
          && request.resource.data.entityType == 'DRAFT'
          && get(/databases/$(database)/documents/evidence_analysis_drafts/$(request.resource.data.entityId)).data.createdBy == uid())
      );
      allow update, delete: if false;
    }

    // Review assignments and attestations (planned editorial review).
    match /review_assignments/{id} {
      allow read: if signedIn() && (resource.data.reviewerId == uid() || isEditor());
      allow write: if role() == 'editorial_admin' && request.resource.data.reviewerId != uid();
    }
    match /attestations/{id} {
      allow read: if true;
      allow create: if role() == 'scholarly_reviewer'
        && request.resource.data.reviewerId == uid()
        && get(/databases/$(database)/documents/review_assignments/$(request.resource.data.assignmentId)).data.reviewerId == uid()
        && get(/databases/$(database)/documents/review_assignments/$(request.resource.data.assignmentId)).data.status == 'open';
      allow update, delete: if false;
    }

    // Private institutional workspaces (Decision Twin): members only. No client can write membership; the owner
    // manages it in the Firebase console (there is no admin key on the server).
    // Public Decision Passport registry and revocations (docs/PASSPORT_POLICY.md). Anyone can read; entries are created
    // only together with the issuing / revoking step of a workspace passport draft, and never change or disappear.
    match /issued_passports/{sha} {
      allow read: if true;
      allow create: if signedIn()
        && sha.matches('^[0-9a-f]{64}$')
        && request.resource.data.sha256 == sha
        && request.resource.data.kind == 'deep-analysis'
        && isMember(request.resource.data.tenant)
        && request.resource.data.kid.matches('^ed25519-[0-9a-f]{16}$')
        && request.resource.data.signatureValue is string
        && get(/databases/$(database)/documents/tenants/$(request.resource.data.tenant)/passport_drafts/$(request.resource.data.draftId)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/tenants/$(request.resource.data.tenant)/passport_drafts/$(request.resource.data.draftId)).data.status == 'issued'
        && getAfter(/databases/$(database)/documents/tenants/$(request.resource.data.tenant)/passport_drafts/$(request.resource.data.draftId)).data.passportSha256 == sha
        && getAfter(/databases/$(database)/documents/tenants/$(request.resource.data.tenant)/passport_drafts/$(request.resource.data.draftId)).data.issuedBy == uid()
        && getAfter(/databases/$(database)/documents/tenants/$(request.resource.data.tenant)/passport_drafts/$(request.resource.data.draftId)).data.issuedAt == request.resource.data.issuedAt;
      allow update, delete: if false;
    }
    match /passport_revocations/{sha} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.sha256 == sha
        && request.resource.data.reason in ['superseded', 'withdrawn', 'error', 'key-compromise']
        && (request.resource.data.reason == 'superseded') == (request.resource.data.supersededBy != null)
        && get(/databases/$(database)/documents/issued_passports/$(sha)).data.tenant == request.resource.data.tenant
        && get(/databases/$(database)/documents/issued_passports/$(sha)).data.draftId == request.resource.data.draftId
        && isTenantEditor(request.resource.data.tenant)
        && getAfter(/databases/$(database)/documents/tenants/$(request.resource.data.tenant)/passport_drafts/$(request.resource.data.draftId)).data.status == 'revoked'
        && getAfter(/databases/$(database)/documents/tenants/$(request.resource.data.tenant)/passport_drafts/$(request.resource.data.draftId)).data.revokedBy == uid();
      allow update, delete: if false;
    }

    match /tenants/{t} {
      allow read: if isMember(t);
      allow write: if false;
      match /members/{member} {
        allow read: if isMember(t);
        allow write: if false;
      }
      function ws(sub, id) { return /databases/$(database)/documents/tenants/$(t)/$(sub)/$(id); }
      // The audit event `a` of change `c` is referenced by the passport draft `pid` after the batch.
      function passportStep(pid, c, a) {
        return getAfter(ws('passport_drafts', pid)).data.get(
          c == 'DRAFTED' ? 'draftAuditId' : c == 'SUBMITTED' ? 'submitAuditId' : c == 'ISSUED' ? 'issueAuditId' : c == 'REVOKED' ? 'revokeAuditId' : 'reviewAuditId', '') == a
          && (c == 'DRAFTED' ? !exists(ws('passport_drafts', pid)) : exists(ws('passport_drafts', pid)));
      }

      // Evidence workflow (docs/EVIDENCE_WORKFLOW_E2E.md). Imported documents are immutable; each import is written
      // with its audit event in one batch.
      match /documents/{d} {
        allow read: if isMember(t);
        allow create: if isMember(t)
          && request.resource.data.id == d
          && request.resource.data.tenant == t
          && request.resource.data.importedBy == uid()
          && getAfter(ws('audit', request.resource.data.auditId)).data.entityId == d
          && getAfter(ws('audit', request.resource.data.auditId)).data.changeType == 'IMPORTED';
        allow update, delete: if false;
      }
      // Decisions: proposed by a member as themselves; decided once, by a workspace editor who is not the proposer,
      // with the audit event in the same batch. Only the decision fields may change.
      match /decisions/{id} {
        allow read: if isMember(t);
        allow create: if isMember(t)
          && request.resource.data.id == id
          && request.resource.data.tenant == t
          && request.resource.data.proposedBy == uid()
          && request.resource.data.status == 'proposed'
          && request.resource.data.decidedBy == null
          && getAfter(ws('audit', request.resource.data.proposalAuditId)).data.entityId == id
          && getAfter(ws('audit', request.resource.data.proposalAuditId)).data.changeType == 'PROPOSED';
        allow update: if isTenantEditor(t)
          && resource.data.status == 'proposed'
          && resource.data.proposedBy != uid()
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.decidedBy == uid()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'decidedBy', 'decidedByEmail', 'decidedAt', 'decisionNote', 'decisionAuditId'])
          && getAfter(ws('audit', request.resource.data.decisionAuditId)).data.entityId == id
          && getAfter(ws('audit', request.resource.data.decisionAuditId)).data.changeType
               == (request.resource.data.status == 'approved' ? 'APPROVED' : 'REJECTED');
        allow delete: if false;
      }
      // Workspace audit log: append-only, attributed to the signed-in user, tied to the change it records.
      match /audit/{a} {
        allow read: if isMember(t);
        allow create: if isMember(t)
          && request.resource.data.id == a
          && request.resource.data.tenant == t
          && request.resource.data.actorId == uid()
          && (
            (request.resource.data.changeType == 'IMPORTED' && request.resource.data.entityType == 'DOCUMENT'
              && !exists(ws('documents', request.resource.data.entityId))
              && getAfter(ws('documents', request.resource.data.entityId)).data.importedBy == uid()
              && getAfter(ws('documents', request.resource.data.entityId)).data.auditId == a)
            || (request.resource.data.changeType == 'PROPOSED' && request.resource.data.entityType == 'DECISION'
              && !exists(ws('decisions', request.resource.data.entityId))
              && getAfter(ws('decisions', request.resource.data.entityId)).data.proposedBy == uid()
              && getAfter(ws('decisions', request.resource.data.entityId)).data.proposalAuditId == a)
            || (request.resource.data.changeType in ['APPROVED', 'REJECTED'] && request.resource.data.entityType == 'DECISION'
              && isTenantEditor(t)
              && get(ws('decisions', request.resource.data.entityId)).data.status == 'proposed'
              && get(ws('decisions', request.resource.data.entityId)).data.proposedBy != uid()
              && getAfter(ws('decisions', request.resource.data.entityId)).data.decidedBy == uid()
              && getAfter(ws('decisions', request.resource.data.entityId)).data.decisionAuditId == a)
            || (request.resource.data.changeType == 'EXPORTED' && request.resource.data.entityType == 'DECISION'
              && exists(ws('decisions', request.resource.data.entityId))
              && existsAfter(ws('passports', request.resource.data.passportSha256)))
            // Passport lifecycle events: valid only together with the draft change they record (checked there).
            || (request.resource.data.entityType == 'PASSPORT'
              && request.resource.data.changeType in ['DRAFTED', 'SUBMITTED', 'APPROVED', 'REJECTED', 'ISSUED', 'REVOKED']
              && passportStep(request.resource.data.entityId, request.resource.data.changeType, a))
          );
        allow update, delete: if false;
      }
      // Exported passport hashes: recorded once, never changed.
      match /passports/{sha} {
        allow read: if isMember(t);
        allow create: if isMember(t)
          && request.resource.data.sha256 == sha
          && request.resource.data.tenant == t
          && request.resource.data.exportedBy == uid()
          && exists(ws('decisions', request.resource.data.decisionId));
        allow update, delete: if false;
      }

      // Decision Passport drafts (src/lib/passport/store.ts, docs/PASSPORT_POLICY.md). draft → submitted (by the
      // proposer) → approved | rejected (by a different workspace editor) → issued (by the proposer or reviewer, with
      // the public registry entry in the same batch) → revoked (by an editor, with the public revocation). Every step
      // writes its audit event in the same batch; only the fields of that step may change; nothing is deleted.
      // The rules cannot verify Ed25519: an "issued" record written around the server has no valid signature by the
      // published key and fails every verifier.
      match /passport_drafts/{id} {
        function pAudit(aid, change) {
          return getAfter(ws('audit', aid)).data.entityId == id
            && getAfter(ws('audit', aid)).data.entityType == 'PASSPORT'
            && getAfter(ws('audit', aid)).data.changeType == change;
        }
        function ownEmail(e) {
          return e == null || (e == request.auth.token.get('email', '') && request.auth.token.get('email_verified', false) == true);
        }
        function only(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
        allow read: if isMember(t);
        allow create: if isMember(t)
          && request.resource.data.id == id
          && request.resource.data.tenant == t
          && request.resource.data.kind == 'deep-analysis'
          && request.resource.data.createdBy == uid()
          && ownEmail(request.resource.data.createdByEmail)
          && request.resource.data.status == 'draft'
          && request.resource.data.bindingJson is string
          && request.resource.data.bindingSha256.matches('^[0-9a-f]{64}$')
          && request.resource.data.reviewedBy == null
          && request.resource.data.issuedAt == null
          && request.resource.data.passportSha256 == null
          && request.resource.data.signatureJson == null
          && request.resource.data.revokedAt == null
          && (request.resource.data.supersedes == null
              || get(/databases/$(database)/documents/issued_passports/$(request.resource.data.supersedes)).data.tenant == t)
          && pAudit(request.resource.data.draftAuditId, 'DRAFTED');
        allow update: if (
            // Submit: the proposer only.
            isMember(t)
            && resource.data.status == 'draft' && request.resource.data.status == 'submitted'
            && resource.data.createdBy == uid()
            && only(['status', 'submittedAt', 'submitAuditId'])
            && pAudit(request.resource.data.submitAuditId, 'SUBMITTED')
          ) || (
            // Review: a workspace editor who is not the proposer (two-person rule).
            isTenantEditor(t)
            && resource.data.status == 'submitted' && request.resource.data.status in ['approved', 'rejected']
            && resource.data.createdBy != uid()
            && request.resource.data.reviewedBy == uid()
            && ownEmail(request.resource.data.reviewedByEmail)
            && only(['status', 'reviewedBy', 'reviewedByEmail', 'reviewerShowEmail', 'reviewedAt', 'reviewNote', 'reviewAuditId'])
            && pAudit(request.resource.data.reviewAuditId, request.resource.data.status == 'approved' ? 'APPROVED' : 'REJECTED')
          ) || (
            // Issue: an approved draft, by its proposer or reviewer, with its registry entry in the same batch.
            isMember(t)
            && resource.data.status == 'approved' && request.resource.data.status == 'issued'
            && resource.data.reviewedBy != null && resource.data.reviewedBy != resource.data.createdBy
            && (resource.data.createdBy == uid() || resource.data.reviewedBy == uid())
            && request.resource.data.issuedBy == uid()
            && only(['status', 'issuedAt', 'issuedBy', 'issueAuditId', 'passportSha256', 'passportAuditIds', 'signatureJson', 'kid'])
            && existsAfter(/databases/$(database)/documents/issued_passports/$(request.resource.data.passportSha256))
            && pAudit(request.resource.data.issueAuditId, 'ISSUED')
          ) || (
            // Revoke: a workspace editor, with the public revocation in the same batch.
            isTenantEditor(t)
            && resource.data.status == 'issued' && request.resource.data.status == 'revoked'
            && request.resource.data.revokedBy == uid()
            && only(['status', 'revokedAt', 'revokedBy', 'revocationReason', 'revokeAuditId'])
            && existsAfter(/databases/$(database)/documents/passport_revocations/$(resource.data.passportSha256))
            && pAudit(request.resource.data.revokeAuditId, 'REVOKED')
          );
        allow delete: if false;
      }

      // Every other subcollection; `members` and the evidence-workflow collections above are excluded, so a member
      // cannot add members, change roles or bypass the workflow rules.
      match /{sub}/{doc=**} {
        allow read, write: if isMember(t) && !(sub in ['members', 'documents', 'decisions', 'audit', 'passports', 'passport_drafts']);
      }
    }
  }
}
