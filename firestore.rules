rules_version = '2';

// AbrahamMoses security rules (ADR 0001). Project abrahammoses-a0a26.
//
// There is no admin key: every write, from the browser SDK or from a server route forwarding the user's own ID
// token, is checked here. Deny by default; anonymous visitors and anonymous-auth users never write; roles come only
// from the custom claim `am_role`; the editor is never the proposer; the canonical record changes only in the same
// atomic batch as an approved decision and its audit event; audit events are append-only; tenants are isolated.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function uid() { return request.auth.uid; }
    function role() {
      return signedIn() ? request.auth.token.get('am_role', 'research_contributor') : 'public_reader';
    }
    function isEditor() { return role() in ['research_editor', 'editorial_admin']; }
    function isMember(t) {
      return signedIn() && exists(/databases/$(database)/documents/tenants/$(t)/members/$(uid()));
    }
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function proposalPath(pid) { return /databases/$(database)/documents/evidence_challenge_proposals/$(pid); }
    function auditPath(aid) { return /databases/$(database)/documents/evidence_audit/$(aid); }
    // True only inside the batch in which this editor approves proposal `pid`, which was undecided before the batch
    // and was not proposed by them.
    function approvingNow(pid) {
      return signedIn() && isEditor()
        && get(proposalPath(pid)).data.status == 'proposed'
        && get(proposalPath(pid)).data.proposedBy != uid()
        && getAfter(proposalPath(pid)).data.status == 'approved'
        && getAfter(proposalPath(pid)).data.decidedBy == uid();
    }

    // Canonical record: public read. It changes only with an approval: the revised analysis, the proposal decision
    // and the audit event in one batch.
    match /evidence_analyses/{id} {
      allow read: if true;
      allow create, update: if approvingNow(request.resource.data.lastProposalId)
        && getAfter(proposalPath(request.resource.data.lastProposalId)).data.analysisId == id
        && existsAfter(auditPath(request.resource.data.lastAuditId));
      allow delete: if false;
    }
    match /evidence_challenges/{id} {
      allow read: if true;
      allow create: if approvingNow(request.resource.data.proposalId)
        && getAfter(proposalPath(request.resource.data.proposalId)).data.claimId == request.resource.data.claimId;
      allow update, delete: if false;
    }

    // Proposals (user research): kept apart from the canonical record. Signed-in users only.
    match /evidence_challenge_proposals/{id} {
      allow read: if signedIn() && (resource.data.proposedBy == uid() || isEditor());
      allow create: if signedIn()
        && request.resource.data.proposedBy == uid()
        && request.resource.data.status == 'proposed'
        && request.resource.data.decidedBy == null;
      // A decision: an editor who is not the proposer, recorded as themselves, with its audit event in the same
      // batch. Nothing but the decision fields may change.
      allow update: if signedIn() && isEditor()
        && resource.data.status == 'proposed'
        && resource.data.proposedBy != uid()
        && request.resource.data.status in ['approved', 'rejected', 'superseded']
        && request.resource.data.decidedBy == uid()
        && unchanged(['json', 'claimId', 'analysisId', 'proposedBy', 'proposerRole', 'idempotencyKey', 'createdAt'])
        && existsAfter(auditPath(request.resource.data.decisionAuditId))
        && getAfter(auditPath(request.resource.data.decisionAuditId)).data.proposalId == id;
      allow delete: if false;
    }

    // Drafts: private to their creator; never published by being created.
    match /evidence_analysis_drafts/{id} {
      allow read: if signedIn() && resource.data.createdBy == uid();
      allow create: if signedIn() && request.resource.data.createdBy == uid();
      allow update, delete: if false;
    }

    // Audit log: append-only, every event attributed to the signed-in user who caused it.
    match /evidence_audit/{id} {
      allow read: if role() in ['editorial_admin', 'system_admin'];
      allow create: if signedIn() && request.resource.data.actorId == uid() && (
        // A decision event, in the batch that decides the proposal
        (request.resource.data.changeType in ['APPROVED', 'REJECTED', 'UPDATED']
          && isEditor()
          && get(proposalPath(request.resource.data.proposalId)).data.status == 'proposed'
          && getAfter(proposalPath(request.resource.data.proposalId)).data.decidedBy == uid())
        // The proposer's own submission event
        || (request.resource.data.changeType == 'PROPOSED'
          && request.resource.data.entityType == 'PROPOSAL'
          && request.resource.data.proposalId == request.resource.data.entityId
          && get(proposalPath(request.resource.data.entityId)).data.proposedBy == uid())
        // The creator's own draft event
        || (request.resource.data.changeType == 'DRAFTED'
          && request.resource.data.entityType == 'DRAFT'
          && get(/databases/$(database)/documents/evidence_analysis_drafts/$(request.resource.data.entityId)).data.createdBy == uid())
      );
      allow update, delete: if false;
    }

    // Review assignments and attestations (planned editorial review).
    match /review_assignments/{id} {
      allow read: if signedIn() && (resource.data.reviewerId == uid() || isEditor());
      allow write: if role() == 'editorial_admin' && request.resource.data.reviewerId != uid();
    }
    match /attestations/{id} {
      allow read: if true;
      allow create: if role() == 'scholarly_reviewer'
        && request.resource.data.reviewerId == uid()
        && get(/databases/$(database)/documents/review_assignments/$(request.resource.data.assignmentId)).data.reviewerId == uid()
        && get(/databases/$(database)/documents/review_assignments/$(request.resource.data.assignmentId)).data.status == 'open';
      allow update, delete: if false;
    }

    // Private institutional workspaces (Decision Twin): members only. No client can write membership; the owner
    // manages it in the Firebase console (there is no admin key on the server).
    match /tenants/{t} {
      allow read: if isMember(t);
      allow write: if false;
      match /members/{member} {
        allow read: if isMember(t);
        allow write: if false;
      }
      // Every other subcollection; `members` is excluded so a member cannot add members or change roles.
      match /{sub}/{doc=**} {
        allow read, write: if isMember(t) && sub != 'members';
      }
    }
  }
}
