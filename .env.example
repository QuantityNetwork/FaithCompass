# ---------------------------------------------------------------------------
# Site and interfaces
# ---------------------------------------------------------------------------
# Canonical origin. Every URL the site, REST API, MCP manifest, canonical links
# and sitemap print comes from this one setting. Set it for Production only,
# BEFORE building: static pages bake it into canonical links. Unset, a Vercel
# preview names its own branch URL.
# ABRAHAMMOSES_PUBLIC_ORIGIN=https://am.sagolik.com

# Published in the Privacy Policy and Terms. The status page warns while the
# privacy contact is unset.
# ABRAHAMMOSES_PRIVACY_CONTACT=
# ABRAHAMMOSES_CONTACT=

# Per-client rate limit for the REST API and MCP server (default 120/minute).
# API_RATE_LIMIT_PER_MINUTE=120

# Local editorial preview only: serve draft revisions. Never set in production.
# RECORD_INCLUDE_DRAFTS=1

# ---------------------------------------------------------------------------
# Evidence Intelligence reasoning provider
# ---------------------------------------------------------------------------
# corpus    — deterministic, corpus-backed analyses. No external model calls,
#             no possibility of fabricated citations. This is the default.
# anthropic — Claude-backed reasoning. Requires ANTHROPIC_API_KEY. All output is
#             validated against the structured schemas in src/lib/evidence/schema.ts
#             and every citation is checked against the corpus before persistence.
EVIDENCE_PROVIDER=corpus

# ANTHROPIC_API_KEY=
# Fast model: claim extraction, classification, summarisation.
EVIDENCE_MODEL_FAST=claude-haiku-4-5-20251001
# Deep model: contested interpretation, historical synthesis, Challenge Assessment.
EVIDENCE_MODEL_DEEP=claude-opus-5

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# supabase — required for any deployed environment. A serverless host has a
#            read-only bundle filesystem and wipes /tmp between cold starts, so
#            the json store throws on first write and every page 500s.
# json     — file-backed, for local development only.
# memory   — a deployment without a database: the curated demonstrations are
#            rebuilt in memory, and saving new analyses or challenges is
#            refused with a 503 rather than accepted and lost on a cold start.
#
# Leave unset to auto-select: Supabase when it is configured, json otherwise.
# EVIDENCE_STORE=supabase

# Firebase (ADR 0001), project abrahammoses-a0a26. No admin key: users sign in
# in the browser and every write carries their own ID token, checked by
# firestore.rules. The web config below is public by design (paste it from
# Console > Project settings > Your apps > Web).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=abrahammoses-a0a26.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=abrahammoses-a0a26
# NEXT_PUBLIC_FIREBASE_APP_ID=
# FIREBASE_PROJECT_ID=abrahammoses-a0a26   # optional; defaults to the public one
# AUTH_PROVIDER=firebase
# EVIDENCE_STORE=firestore                  # required on a deployed runtime
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085    # local emulator only

# Superseded (ADR 0001). Server-side only. SUPABASE_SERVICE_ROLE_KEY bypasses row-level security and
# must never be exposed to the browser — do not prefix it with NEXT_PUBLIC_.
# Apply supabase/migrations/20260911000000_evidence_intelligence.sql first.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Directory backing the json store. Local development only.
EVIDENCE_DATA_DIR=./data
