# ---------------------------------------------------------------------------
# Evidence Intelligence reasoning provider
# ---------------------------------------------------------------------------
# corpus    — deterministic, corpus-backed analyses. No external model calls,
#             no possibility of fabricated citations. This is the default.
# anthropic — Claude-backed reasoning. Requires ANTHROPIC_API_KEY. All output is
#             validated against the structured schemas in src/lib/evidence/schema.ts
#             and every citation is checked against the corpus before persistence.
EVIDENCE_PROVIDER=corpus

# ANTHROPIC_API_KEY=
# Fast model: claim extraction, classification, summarisation.
EVIDENCE_MODEL_FAST=claude-haiku-4-5-20251001
# Deep model: contested interpretation, historical synthesis, Challenge Assessment.
EVIDENCE_MODEL_DEEP=claude-opus-5

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# supabase — required for any deployed environment. A serverless host has a
#            read-only bundle filesystem and wipes /tmp between cold starts, so
#            the json store throws on first write and every page 500s.
# json     — file-backed, for local development only.
#
# Leave unset to auto-select: Supabase when it is configured, json otherwise.
# EVIDENCE_STORE=supabase

# Server-side only. SUPABASE_SERVICE_ROLE_KEY bypasses row-level security and
# must never be exposed to the browser — do not prefix it with NEXT_PUBLIC_.
# Apply supabase/migrations/20260911000000_evidence_intelligence.sql first.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Directory backing the json store. Local development only.
EVIDENCE_DATA_DIR=./data
