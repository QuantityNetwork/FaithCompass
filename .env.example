# ─────────────────────────────────────────────────────────────
# Sagolik MCP — environment configuration
# Never commit real values. Server-only variables must never be
# prefixed with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Public origin of this deployment (used for OAuth metadata and MCP URLs)
SAGOLIK_PUBLIC_URL=https://mcp.sagolik.com

# Supabase (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — SERVER ONLY. Used by the MCP gateway after
# policy evaluation; every query is scoped to the authenticated tenant.
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key, base64 encoded (openssl rand -base64 32).
# Encrypts webhook signing secrets and provider credentials at rest.
SAGOLIK_ENCRYPTION_KEY=

# Optional. "demo" forces the in-memory demo backend (sandbox only).
# When unset, demo mode is used only if Supabase is not configured.
SAGOLIK_MODE=

# Secret for scheduled maintenance (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Optional open-banking provider (Plaid). Leave empty to keep the
# provider disabled; Sagolik never fabricates live banking data.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
